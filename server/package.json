{
  "name": "sistema-oficina",
  "version": "1.0.0",
  "description": "Sistema completo de gerenciamento de oficina mecânica com segurança e testes",
  "main": "server/src/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server/src/index.js",
    "server:test": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=server",
    "client:dev": "cd client && npm run dev",
    "client:test": "cd client && npm test",
    "test": "npm run server:test && npm run client:test",
    "test:watch": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/src/index.js",
    "setup": "npm install && cd client && npm install"
  },
  "keywords": ["oficina", "gestão", "workshop", "mecânica"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^9.2.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.11"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": ["**/server/**/*.test.js"],
    "collectCoverageFrom": [
      "server/src/**/*.js",
      "!server/src/index.js"
    ]
  }
}

